NODE_ENV=production
PORT=3000
HOST=voting.jeinsat.com
CORS_ORIGINS=https://voting.jeinsat.com
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/votingsystem?retryWrites=true&w=majority
SESSION_SECRET=replace-with-a-long-random-session-secret
ADMIN_SECRET_KEY=replace-with-a-long-random-admin-key
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-admin-password
VOTER_CODE_PEPPER=replace-with-a-long-random-voter-code-pepper
JWT_SECRET=replace-with-a-long-random-jwt-secret
JWT_EXPIRY=24h