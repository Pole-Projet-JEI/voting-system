# Copy to .env.performance (gitignored) and replace every placeholder locally.
TEST_RUN_ID=0123456789abcdef
TEST_DB_NAME=voting_performance_test_0123456789abcdef
TEST_VOTER_CODES_FILE=./.test-data/voter-codes.json
BASE_URL=http://127.0.0.1:3180
PROFILE=smoke
VOTING_MODE=benchmark
