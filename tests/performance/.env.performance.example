SSE_EXPECT_LIMIT=false
SSE_MAX_CONNECTIONS=100
SSE_HEARTBEAT_INTERVAL_MS=25000
TEST_DUPLICATES=false
ADMIN_USERNAME=performance-test-admin
ADMIN_PASSWORD=Replace-With-Unique-Local-Test-Password-123!
