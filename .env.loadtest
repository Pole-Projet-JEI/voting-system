# Load Test Configuration
# Copy this file and modify values as needed

# Base URL of your voting system API
BASE_URL=http://localhost:3000

# Number of concurrent users to simulate
NUM_USERS=600

# Number of parallel/concurrent HTTP requests
CONCURRENT_REQUESTS=600

# Team ID to vote for (must exist in your database)
TEAM_ID=6921bda18b2afe61ca8cd3ca


# Vote choice: "yes" or "no"
VOTE_CHOICE=yes
